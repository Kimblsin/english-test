# Bu faylni ".env" nomi bilan nusxalang va to'ldiring

# @BotFather bergan token
BOT_TOKEN=123456:ABC-DEF...

# Admin Telegram ID'lari (vergul bilan). ID ni @userinfobot dan bilib oling
ADMIN_IDS=123456789

# Mini App uchun HTTPS manzil (ngrok / Cloudflare Tunnel / domen), oxirida "/" bo'lmasin
WEBAPP_URL=https://sizning-manzil.example.com

# Server porti va kunlik eslatma soati (Toshkent vaqti)
PORT=8080
REMINDER_HOUR=9

# Brauzerda sinash uchun 1 qiling (Telegram'siz ochilganda ishlaydi). Productionda 0 bo'lsin!
DEV_MODE=0
